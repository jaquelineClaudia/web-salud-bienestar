# Copia este archivo como .env.local (en local) o pon estas variables en Vercel.
# Ninguna es obligatoria: sin ellas la web funciona en "modo prueba".

# Fotos del fabricante: "no" las oculta y deja los huecos con su descripción.
NEXT_PUBLIC_FOTOS_FABRICANTE=si

# Tienda Shopify (Ajustes > Apps > Desarrollar apps > Storefront API). Sin ellas, tienda simulada.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=

# Formularios y asistente: correo con Resend (resend.com) y/o fila en una hoja de Google.
RESEND_API_KEY=
RESEND_FROM=
GOOGLE_SHEETS_WEBHOOK_URL=

# Asistente de compra (console.anthropic.com). Sin ella, el asistente remite al teléfono y WhatsApp.
ANTHROPIC_API_KEY=

# Google Analytics 4 (solo se carga si la persona acepta las cookies de análisis).
NEXT_PUBLIC_GA_ID=
